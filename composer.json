{
  "name": "alma/auth",
  "description": "ALMA Auth — autenticación headless (Sanctum, 2FA TOTP, RBAC, refresh tokens, audit). Paquete Alma Dev.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.50.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Alma\\Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Alma\\Auth\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "style": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Alma\\Auth\\AuthServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
